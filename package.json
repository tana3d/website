{
  "name": "tana-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --host 127.0.0.1 --port 4321",
    "build": "astro build",
    "preview": "astro preview --host 127.0.0.1 --port 4321",
    "check": "astro check",
    "test": "node --test tests/*.test.mjs",
    "db:local": "wrangler d1 migrations apply DB --local",
    "db:remote": "wrangler d1 migrations apply DB --remote",
    "seed:local": "node scripts/seed-local.mjs",
    "test:ui": "node tests/ui.mjs",
    "prepare:assets": "node scripts/prepare-starter-assets.mjs",
    "seed:cloudflare": "node scripts/seed-cloudflare.mjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.3.3",
    "@google/model-viewer": "^4.3.1",
    "@tailwindcss/vite": "^4.1.3",
    "astro": "^7.3.5",
    "jose": "^6.1.0",
    "tailwindcss": "^4.1.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@cloudflare/workers-types": "latest",
    "@gltf-transform/core": "latest",
    "@gltf-transform/extensions": "latest",
    "@playwright/test": "latest",
    "@types/three": "latest",
    "gifenc": "^1.0.3",
    "sharp": "^0.35.5",
    "three": "latest",
    "typescript": "^5.9.3",
    "wrangler": "^4.125.0"
  }
}
