---
export const prerender = false;

import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import ProjectList from '../components/ProjectList.astro';
import { env } from 'cloudflare:workers';
import { listAssets } from '../lib/library';
import type { Bindings } from '../lib/types';
import '../styles/global.css'
if (Astro.url.hostname==='admin.tana.gg') return Astro.rewrite('/admin');
if (['q','category','tag'].some(key=>Astro.url.searchParams.has(key))) return Astro.redirect(`/search?${Astro.url.searchParams}`);
let catalog = { assets: [], total: 0, page: 1, pages: 0 } as Awaited<ReturnType<typeof listAssets>>;
let unavailable = false;
try { catalog = await listAssets(env as unknown as Bindings, Astro.url.searchParams); } catch { unavailable = true; }
// Every visit gets a new shuffle, including refreshes through an edge cache.
Astro.response.headers.set('Cache-Control','no-store');
const nextParams = new URLSearchParams(Astro.url.searchParams);
nextParams.set('page',String(catalog.page + 1));
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body class="w-full ">
		<Header />
		<div class="p-0 w-screen m-0 max-w-full ">
          <ProjectList projects={catalog.assets} />
          {unavailable ? <p class="library-message" role="status">The library is temporarily unavailable. Please try again shortly.</p> : !catalog.total ? <p class="library-message">{Astro.url.search ? 'No models matched. Try another search.' : 'The library is getting its first assets. Come back soon.'}</p> : null}
          {!unavailable && catalog.total > 0 && <div class="library-loader" data-library-loader data-page={catalog.page} data-pages={catalog.pages}>
            <p data-library-status role="status" aria-live="polite"></p>
            <a data-load-more href={`/?${nextParams}`} hidden={catalog.page >= catalog.pages}>Load more assets</a>
          </div>}

		</div>
		<Footer />
	</body>
</html>
<script>
  import '../scripts/library-scroll';
</script>
<style>
  .library-message,.library-loader { margin:30px 3%; font-size:15px; }
  .library-loader { text-align:center; min-height:32px; }
  .library-loader p:empty { display:none; }
  .library-loader a { display:inline-block; padding:10px 20px; border:1px solid currentColor; border-radius:8px; }
  .library-loader a[hidden] { display:none; }
</style>
