---
export const prerender = false;

import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import ProjectList from '../components/ProjectList.astro';
import { env } from 'cloudflare:workers';
import { listAssets } from '../lib/library';
import type { Bindings } from '../lib/types';
import '../styles/global.css'
if (Astro.url.hostname==='admin.tana.gg') return Astro.rewrite('/admin');
if (['q','category','tag'].some(key=>Astro.url.searchParams.has(key))) return Astro.redirect(`/search?${Astro.url.searchParams}`);
let catalog = { assets: [], total: 0, page: 1, pages: 0 } as Awaited<ReturnType<typeof listAssets>>;
let unavailable = false;
try { catalog = await listAssets(env as unknown as Bindings, Astro.url.searchParams); } catch { unavailable = true; }
// Every visit gets a new shuffle, including refreshes through an edge cache.
Astro.response.headers.set('Cache-Control','no-store');
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body class="w-full ">
		<Header />
		<div class="p-0 w-screen m-0 max-w-full ">
          <ProjectList projects={catalog.assets} />
          {unavailable ? <p class="library-message" role="status">The library is temporarily unavailable. Please try again shortly.</p> : !catalog.total ? <p class="library-message">{Astro.url.search ? 'No models matched. Try another search.' : 'The library is getting its first assets. Come back soon.'}</p> : null}
          {catalog.pages > 1 && <nav class="pagination" aria-label="Library pages">{Array.from({length:catalog.pages},(_,i)=>i+1).filter(p=>Math.abs(p-catalog.page)<3||p===1||p===catalog.pages).map(p=>{const params=new URLSearchParams(Astro.url.searchParams);params.set('page',String(p));return <a href={`/?${params}`} aria-current={p===catalog.page ? 'page' : undefined}>{p}</a>;})}</nav>}
		</div>
		<Footer />
	</body>
</html>
<style>
  .library-message,.pagination { margin:30px 3%; font-size:15px; }
  .pagination { display:flex; gap:12px; }
</style>
