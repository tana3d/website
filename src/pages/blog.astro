---
import { getCollection } from 'astro:content'
import Layout from '../layouts/Page.astro'
import FormattedDate from '../components/FormattedDate.astro'

export const prerender = true

// Get all blog posts sorted by date
const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
)

// Get all unique tags
const allTags = [...new Set(posts.flatMap(post => post.data.tags))]

// Pagination
const POSTS_PER_PAGE = 10
const currentPage = 1
const totalPages = Math.ceil(posts.length / POSTS_PER_PAGE)
const startIndex = (currentPage - 1) * POSTS_PER_PAGE
const endIndex = startIndex + POSTS_PER_PAGE
const paginatedPosts = posts.slice(startIndex, endIndex)
---

<Layout title="Blog — tana">
	<div class="bg-slate-100 w-[90%] m-auto pt-4 pb-8">
		<span class="text-3xl mb-6 block">blog</span>

		<div class="flex flex-col md:flex-row gap-6">
			<!-- Main content column -->
			<div class="md:w-2/3">
				{paginatedPosts.map((post) => (
					<article class="bg-white rounded-xl shadow-sm mb-6 overflow-hidden hover:shadow-md transition-shadow">
						{post.data.heroImage && (
							<div class="w-full h-38 overflow-hidden">
								<a href={`/blog/${post.id}`}>
									<img
										src={post.data.heroImage}
										alt={post.data.title}
										class="w-full h-full object-cover"
									/>
								</a>
							</div>
						)}
						<div class="p-6">
							<div class="mb-7">
								<a href={`/blog/${post.id}`} class="hover:text-blue-600 transition-colors">
									<h3 class="text-md font-bold">{post.data.title}</h3>
								</a>
							</div>
							<div class="flex items-center gap-4 text-sm text-gray-600 mb-8">
								<span class="flex items-center gap-2">
									<img src="/favicon.svg" class="w-5 h-5 rounded-full" alt={post.data.author}>
									{post.data.author}
								</span>
								<span>•</span>
								<FormattedDate date={post.data.pubDate} />
							</div>
							<div class="flex flex-wrap gap-2">
								{post.data.tags.map((tag) => (
									<a href={`/tag/${tag}`} class="inline-block bg-slate-100 hover:bg-slate-200 rounded-full px-3 py-1 text-xs text-gray-700 transition-colors">
										{tag}
									</a>
								))}
							</div>
						</div>
					</article>
				))}

				{/* Pagination */}
				{totalPages > 1 && (
					<div class="w-[80%] mx-auto flex justify-center gap-1 mt-6">
						{Array.from({ length: totalPages }, (_, i) => i + 1).map(page => (
							<a
								href={page === 1 ? '/blog' : `/blog/${page}`}
								class={`px-3 py-2 rounded text-sm bg-white ${
									page === currentPage
										? 'font-bold text-black'
										: 'text-gray-600 hover:bg-gray-100'
								}`}
							>
								{page}
							</a>
						))}
					</div>
				)}
			</div>

			<!-- Tags sidebar -->
			<aside class="md:w-1/3">
				<div class="bg-white rounded-xl shadow-sm p-6 sticky top-4">
					<h3 class="text-xl font-bold mb-4">Tags</h3>
					<div class="flex flex-wrap gap-2">
						{allTags.map((tag) => {
							const count = posts.filter(post => post.data.tags.includes(tag)).length
							return (
								<a
									href={`/tag/${tag}`}
									class="inline-block bg-slate-100 hover:bg-slate-200 rounded-full px-3 py-2 text-sm text-gray-700 transition-colors"
								>
									{tag} <span class="text-gray-500">({count})</span>
								</a>
							)
						})}
					</div>
				</div>
			</aside>
		</div>
	</div>
</Layout>
